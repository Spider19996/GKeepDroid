<?xml version="1.0" encoding="utf-8"?>
<!-- The straight part of a quote block's line in the widgets: the left side of the block, ending 11 dp above its bottom where the
     rounded foot (quote_foot) takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="11dp" android:width="1.5dp" android:gravity="left">
        <shape android:shape="rectangle">
            <solid android:color="#B3A0A0A0" />
        </shape>
    </item>
</layer-list>
